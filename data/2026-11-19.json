{"report_date": "2026-11-19", "sections": {"cityhall": {"approved": true, "report_date": "2026-11-19", "published_count": 28, "generate_briefing": true, "articles": [{"id": "2b96644499efeb44bbb1c35a275d5753", "title": "군산시, 시민고충처리위 출범…복합민원 해법 찾는다", "publisher": "전북중앙", "published_at": "2026-11-18T19:58:58+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1057637", "matched_keywords": ["군산시"], "preferred": true}, {"id": "c9066cf45790313e91bf3ccfef93c846", "title": "‘수산업경영인 전북대회’ 군산서 개최", "publisher": "전북중앙", "published_at": "2026-11-18T17:04:00+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1057636", "matched_keywords": ["군산시"], "preferred": true}, {"id": "73b07db5e74ced4666e7fff2beabbb46", "title": "김재준 시장, 평생학습관 수업 참관·의견 청취", "publisher": "군산뉴스", "published_at": "2026-11-18T16:55:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91788", "matched_keywords": ["군산시"], "preferred": true}, {"id": "081ef246562163ce9b26b2de68af5a83", "title": "군산시, 제1기 ‘시민고충처리위원회’ 출범", "publisher": "군산뉴스", "published_at": "2026-11-18T16:42:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91770", "matched_keywords": ["군산시"], "preferred": true}, {"id": "1c870c7a2bb0c77154c2cc9eefe6daf9", "title": "성산 주열방교회, 이웃돕기성금 3백만 원 기탁", "publisher": "군산뉴스", "published_at": "2026-11-18T16:34:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91768", "matched_keywords": ["군산시"], "preferred": true}, {"id": "b493883017de8f9c9cc33b657397d6b7", "title": "이화숙 의원‘찾아가는 동네문화카페'고도화를", "publisher": "군산뉴스", "published_at": "2026-11-18T16:32:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91789", "matched_keywords": ["군산시"], "preferred": true}, {"id": "b6f318b1f493ae3fba86d578e5220d0c", "title": "전북 수산업경영인 8백여 명 군산 집결", "publisher": "군산뉴스", "published_at": "2026-11-18T13:37:00+09:00", "source_url": "https://www.n