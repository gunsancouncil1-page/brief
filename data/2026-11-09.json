{"report_date": "2026-11-09", "sections": {"cityhall": {"approved": true, "report_date": "2026-11-09", "published_count": 24, "generate_briefing": true, "articles": [{"id": "aebd615819e728d02b02b356a42b1878", "title": "‘선박’-‘주택’-‘차량’ 장소 안 가려… 인식개선 필요", "publisher": "전북중앙", "published_at": "2026-11-08T18:51:45+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1056626", "matched_keywords": ["군산시"], "preferred": true}, {"id": "6e14b55d6250b4ab75f35e6013d689fa", "title": "[제38회 전북역전마라톤] 군산시, 3년 만에 정상 탈환", "publisher": "전북일보", "published_at": "2026-11-08T16:32:38+09:00", "source_url": "https://www.jjan.kr/articleAmp/20261108500178", "matched_keywords": ["군산시"], "preferred": true}, {"id": "dbb872032628ba545c8f8078c080ad0e", "title": "군산시 올해 마지막 민방위 집합교육", "publisher": "전북중앙", "published_at": "2026-11-08T16:31:22+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1056608", "matched_keywords": ["군산시"], "preferred": true}, {"id": "ba2aa9b221069da0a8fbfad8f8db1479", "title": "군산시, 섬마을-순례길 해설사 서촌 선진지 벤치마킹", "publisher": "전북중앙", "published_at": "2026-11-08T16:15:00+09:00", "source_url": "http://www.jjn.co.kr/news/articleView.html?idxno=1056610", "matched_keywords": ["군산시"], "preferred": true}, {"id": "c426d3b1aa6f88907a94ad0ced415b5e", "title": "군산시, 발달장애인 운동회 개최…350명 화합의 장 마련", "publisher": "한스경제", "published_at": "2026-11-07T16:43:14+09:00", "source_url": "http://www.hansbiz.co.kr/news/articleView.html?idxno=880901", "matched_keywords": ["군산시"], "preferred": true}, {"id": "3faabe61923a6db0a705cabb371520e9", "title": "市, 아동학대 예방의 날 기념행사...가족축제", "publisher": "군산뉴스", "published_at": "2026-11-07T14:27:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91560", "matched_keywords": ["군산시"], "preferred": true}, {"id": "510579a6c778679ad78b75462d698562", "title": "[중국 옌타이 와이너리 탐방 ①] 134년 와인의 역사 장위 와이너리", "publisher": "전북중앙", "published_at": "2026-11-06T17:25:52+09:00", "source_url": "http://www.jjn.