{"report_date": "2026-10-26", "sections": {"council": {"approved": true, "report_date": "2026-10-26", "published_count": 20, "generate_briefing": true, "articles": [{"id": "07557edaf1b0a786c37ebd0d2e2c3310", "title": "군산시의회, 제287회 임시회 폐회", "publisher": "군산뉴스", "published_at": "2026-10-23T19:00:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91287", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "c90348146d5598e0f7afe50667029dde", "title": "새창이다리·만경강 일대 군산 새 미래공간으로", "publisher": "군산뉴스", "published_at": "2026-10-23T19:03:00+09:00", "source_url": "http://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91288&sword=&ryear=&rmonth=&rday=&order=&PHPSESSID=2d311964c93db03837558c00422f5ab1", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "5f905801a96e049f312f091479cd8c23", "title": "군산 해양관광 활성화, 안전 대책 수반돼야", "publisher": "군산뉴스", "published_at": "2026-10-23T19:07:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91289", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "b6f35241b8d6769860a32cd2739a6bb8", "title": "수송·미장·지곡동 변화,행정동개편으로 답해야", "publisher": "군산뉴스", "published_at": "2026-10-23T19:12:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91290", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "cddcd613e3d62d3102560478247fb9de", "title": "군산시 재해 대책, 사전 예방에 중점 둬야", "publisher": "군산뉴스", "published_at": "2026-10-23T19:16:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91291", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "d704f15b949edc1da1dde22518339691", "title": "금석배 전국학생축구대회, 이제 군산시 주도를", "publisher": "군산뉴스", "published_at": "2026-10-23T19:20:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91292", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "be870caf419b933871578386d510d570", "title": "경계선 지능인 발견부터 자립까지 대책