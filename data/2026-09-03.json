{"report_date": "2026-09-03", "sections": {"council": {"approved": true, "report_date": "2026-09-03", "published_count": 24, "generate_briefing": true, "articles": [{"id": "11c6ac8f842a274bcf029b9976055704", "title": "군산시의회, 경기침체에 공무국외연수 취소…예산 민생 활용", "publisher": "투데이군산", "published_at": "2026-09-02T18:44:08+09:00", "source_url": "http://www.todaygunsan.co.kr/news/articleView.html?idxno=23683", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "9b55b4f8bcf314d4e2a596f18668c5c5", "title": "“노후한 나운 복지관 무료급식소 방치 안돼”··안전 우려", "publisher": "전북일보", "published_at": "2026-09-02T17:57:11+09:00", "source_url": "https://www.jjan.kr/articleAmp/20260902500067", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "bbdbcff62ee98fe12e803aad11d9b734", "title": "군산시의회, 올해 공무국외연수 ‘안 간다’", "publisher": "군산뉴스", "published_at": "2026-09-02T19:20:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=90443", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "11044e6e7ad603b33847729284de741e", "title": "시의회, 직원 대상 반부패·청렴교육 실시", "publisher": "군산뉴스", "published_at": "2026-09-02T19:24:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=90444", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "7ad74a58abe56c3a4a7c2d539da59756", "title": "국립 의용소방대 연수원 군산시 설립 추진 촉구", "publisher": "군산뉴스", "published_at": "2026-09-02T19:15:00+09:00", "source_url": "https://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=90442", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "66d0b058dfd34cc7820ea7697ec58b1f", "title": "햇빛소득마을 도농복합도시, 농촌 참여 확대 촉구", "publisher": "군산뉴스", "published_at": "2026-09-02T19:08:00+09:00", "source_url": "http://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=90441&sword=&ryear=&rmonth=&rday=&order=&PHPSESSID=81ac2f5ea0db962dbf8c3a2e1f4c4446", "matched_keywords": ["군산시의회"], "preferred": true}, {"id": "25fd0347f5754f70e32a1d26d1a8e141", "title": "지체장애(왜소증),장애정도 판정기준 개선 촉구