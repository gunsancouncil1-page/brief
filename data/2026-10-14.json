{"report_date": "2026-10-14", "sections": {"cityhall": {"approved": true, "report_date": "2026-10-14", "published_count": 28, "generate_briefing": true, "articles": [{"id": "40e32862ec09bfd9df6223772aa9dca2", "title": "군산해경 가을 낚시객 연이어 구조", "publisher": "전북중앙", "published_at": "2026-10-13T17:44:12+09:00", "source_url": "http://www.jjn.co.kr/news/articleView.html?idxno=1054407", "matched_keywords": ["군산시"], "preferred": true}, {"id": "6621db1ccb665b6c318486ae082f0b4e", "title": "군산짬뽕페스티벌 8만명 방문 성료...\"지역 상권 활성화\" |", "publisher": "한스경제", "published_at": "2026-10-13T17:22:25+09:00", "source_url": "http://www.hansbiz.co.kr/news/articleViewAmp.html?idxno=872448", "matched_keywords": ["군산시"], "preferred": true}, {"id": "fd068984b824f850b26fc4bfce58e2fb", "title": "손명엽 군산시해병대전우회장, 장수군 ‘애향장’ 수상", "publisher": "전북중앙", "published_at": "2026-10-13T16:27:27+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1054364", "matched_keywords": ["군산시"], "preferred": true}, {"id": "d5d76965053070016aae2bf23541b5df", "title": "‘군산짬뽕페스티벌’ 8만명 발길 흥행대박", "publisher": "전북중앙", "published_at": "2026-10-13T16:27:25+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1054342", "matched_keywords": ["군산시"], "preferred": true}, {"id": "e96c65044e155c9943efd0906d1b2b35", "title": "군산시 17개 지점 정기 교통량 조사", "publisher": "전북중앙", "published_at": "2026-10-13T16:27:25+09:00", "source_url": "http://www.jjn.co.kr/news/articleViewAmp.html?idxno=1054338", "matched_keywords": ["군산시"], "preferred": true}, {"id": "e05d9241b41087f1eee8da3ae786fd7b", "title": "한국생활개선군산시聯, 장학금 2백만 원 기탁", "publisher": "군산뉴스", "published_at": "2026-10-13T16:12:00+09:00", "source_url": "http://www.newsgunsan.com/ngnews/ngNewsView.php?code=NG2&pid=91083&sword=&ryear=&rmonth=&rday=&order=&PHPSESSID=ea4197bf54737fbafade34ce8a8db546", "matched_keywords": ["군산시"], "preferred": true}, {"id": "38362e5f6a5c5d9e150a861bb2a1f1f7", "title": "군산시어린이집연합회, 환경캠페인 펼쳐", "publisher": "군산뉴스", "published_at": 