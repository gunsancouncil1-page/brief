# Web server. 127.0.0.1 이면 이 PC에서만 열린다.
# Tailscale로 다른 기기에서 쓰려면 `tailscale ip -4` 주소를 넣는다.
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=Asia/Seoul
DATA_DIR=storage
SCHEDULE_ENABLED=true
# Register every weekday's collection automatically, so nothing has to be
# added by hand. Turn this off to register only from the admin page.
AUTO_REGISTER=true
# 승인(자동·수동)이 끝나면 GitHub Pages 게시까지 이어서 한다.
AUTO_PUBLISH=true

# The public pages are read-only. This key unlocks /admin, where collection
# jobs (date + search keywords) are registered.
ADMIN_API_KEY=change-this-to-a-long-random-value
# How long an /admin browser session stays signed in.
ADMIN_SESSION_HOURS=12

# Leave empty for local-only development. Set both this and the Worker secret
# for public deployment so the Tunnel origin cannot be used directly.
ORIGIN_SHARED_SECRET=

# Local Ollama. qwen3:8b is a practical starting point for an RTX 3080 10 GB.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=240

# Google News RSS is a discovery source, not a completeness guarantee.
RSS_ENABLED=true
# Article photos are no longer shown anywhere: the public pages link out to the
# publisher instead. Turn this on only if you need the thumbnails while reviewing.
IMAGES_ENABLED=false
REQUEST_TIMEOUT_SECONDS=25
USER_AGENT=GunsanBriefBot/0.1 (local research dashboard)

